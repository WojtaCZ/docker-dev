{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
        "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
        "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
        "DISABLE_AUTO_COMPACT": "0"
    },
    "enabledPlugins": {
        "superpowers@claude-plugins-official": true,
        "frontend-design@claude-plugins-official": true,
        "modern-web-guidance@claude-plugins-official": true,
        "chrome-devtools-mcp@claude-plugins-official": true,
        "impeccable@impeccable": true
    },
    "extraKnownMarketplaces": {
        "impeccable": {
            "source": {
                "source": "github",
                "repo": "pbakaus/impeccable"
            }
        }
    },
    "mcpServers": {
        "github": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-github"
            ],
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
            }
        },
        "git": {
            "command": "uvx",
            "args": [
                "mcp-server-git"
            ]
        },
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp"
            ]
        },
        "sequential-thinking": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ]
        },
        "fetch": {
            "_comment": "uvx, NOT npx: @modelcontextprotocol/server-fetch does not exist on npm (404); the fetch server is published on PyPI as mcp-server-fetch.",
            "command": "uvx",
            "args": [
                "mcp-server-fetch"
            ]
        },
        "playwright": {
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp",
                "--browser",
                "chromium",
                "--executable-path",
                "/usr/bin/chromium",
                "--no-sandbox"
            ]
        },
        "sqlite": {
            "_comment": "Relative path: resolved against the session's working directory, i.e. the project. scripts/web-post-create.sh creates it.",
            "command": "uvx",
            "args": [
                "mcp-server-sqlite",
                "--db-path",
                ".dev.db"
            ]
        }
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "trail-ensure",
                        "timeout": 120
                    }
                ]
            },
            {
                "matcher": "startup|resume|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "work-notes resume",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "startup|resume|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "claude-usage hook",
                        "timeout": 15
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "work-notes subagent",
                        "timeout": 10
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "claude-usage hook",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "claude-usage hook",
                        "timeout": 15
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Agent|Task|Workflow",
                "hooks": [
                    {
                        "type": "command",
                        "command": "claude-usage hook",
                        "timeout": 60
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "claude-usage hook",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
