# Mirror flat /dev nodes into the running dev container as devices come and go.
# Template: install-host-udev-rules.sh substitutes @DEV_ATTACH@ with the absolute
# path of scripts/dev-attach.sh and installs the result as
# /etc/udev/rules.d/90-dev-emb-attach.rules. (Not named *.rules on purpose, so the
# plain `cp *.rules` in that script doesn't install it unsubstituted.)
#
# systemd-run detaches the docker call from udev's worker, which has a short
# timeout and would kill a slow `docker exec`.
ACTION=="add",    SUBSYSTEM=="tty",    KERNEL=="ttyACM[0-9]*", RUN+="/usr/bin/systemd-run --no-block --collect @DEV_ATTACH@ attach /dev/%k"
ACTION=="add",    SUBSYSTEM=="hidraw", KERNEL=="hidraw[0-9]*", RUN+="/usr/bin/systemd-run --no-block --collect @DEV_ATTACH@ attach /dev/%k"
ACTION=="remove", SUBSYSTEM=="tty",    KERNEL=="ttyACM[0-9]*", RUN+="/usr/bin/systemd-run --no-block --collect @DEV_ATTACH@ detach /dev/%k"
ACTION=="remove", SUBSYSTEM=="hidraw", KERNEL=="hidraw[0-9]*", RUN+="/usr/bin/systemd-run --no-block --collect @DEV_ATTACH@ detach /dev/%k"
ACTION=="add",    SUBSYSTEM=="tty",    KERNEL=="ttyUSB[0-9]*", RUN+="/usr/bin/systemd-run --no-block --collect @DEV_ATTACH@ attach /dev/%k"
ACTION=="remove", SUBSYSTEM=="tty",    KERNEL=="ttyUSB[0-9]*", RUN+="/usr/bin/systemd-run --no-block --collect @DEV_ATTACH@ detach /dev/%k"
